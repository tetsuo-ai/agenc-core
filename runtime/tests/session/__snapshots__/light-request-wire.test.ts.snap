sting approval."},"additional_permissions":{"type":"object","properties":{"network":{"type":"object","properties":{"enabled":{"type":"boolean"}},"additionalProperties":false},"file_system":{"type":"object","properties":{"read":{"type":"array","items":{"type":"string"}},"write":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}},"additionalProperties":false,"description":"Additional sandbox permissions requested for this call."},"justification":{"type":"string","description":"Why the requested permission is needed."},"prefix_rule":{"type":"array","items":{"type":"string"},"description":"Optional reusable command prefix for an approval."}},"required":["cmd"],"additionalProperties":false}}},{"type":"function","function":{"name":"write_stdin","description":"Poll session_id with empty chars, or send input (requires an initial tty=true). Include input newlines. Input uses the session's sandbox_permissions.","parameters":{"type":"object","properties":{"session_id":{"type":"number"},"chars":{"type":"string"},"yield_time_ms":{"type":"number","description":"Wait in ms before returning output and any running session_id."},"max_output_tokens":{"type":"number","description":"Maximum output tokens to return."},"sandbox_permissions":{"type":"string","enum":["default","require_escalated","with_additional_permissions"],"description":"Use require_escalated only when the permission policy allows requesting approval."},"additional_permissions":{"type":"object","properties":{"network":{"type":"object","properties":{"enabled":{"type":"boolean"}},"additionalProperties":false},"file_system":{"type":"object","properties":{"read":{"type":"array","items":{"type":"string"}},"write":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}},"additionalProperties":false,"description":"Additional sandbox permissions requested for this call."},"justification":{"type":"string","description":"Why the requested permission is needed."}},"required":["session_id"],