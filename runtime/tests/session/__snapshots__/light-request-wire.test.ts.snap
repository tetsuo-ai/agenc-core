","with_additional_permissions"],"description":"Use require_escalated only when the permission policy allows requesting approval."},"additional_permissions":{"type":"object","properties":{"network":{"type":"object","properties":{"enabled":{"type":"boolean"}},"additionalProperties":false},"file_system":{"type":"object","properties":{"read":{"type":"array","items":{"type":"string"}},"write":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}},"additionalProperties":false,"description":"Additional sandbox permissions requested for this call."},"justification":{"type":"string","description":"Why the requested permission is needed."}},"required":["session_id"],"additionalProperties":false}}},{"type":"function","function":{"name":"kill_process","description":"Stop this conversation's exec sessions: session_id, session_ids, or all=true. Never find processes to kill by matching command text or file names.","parameters":{"type":"object","properties":{"session_id":{"type":"number"},"session_ids":{"type":"array","items":{"type":"number"}},"all":{"type":"boolean"}},"additionalProperties":false}}},{"type":"function","function":{"name":"FileRead","description":"Read a text file, an image, PDF pages or a notebook. offset is 1-based; limit counts lines (default 2000). PDFs over 10 pages need pages (at most 20). Reads authorize edits; a file listing does not.","parameters":{"type":"object","properties":{"file_path":{"type":"string"},"offset":{"anyOf":[{"type":"number"},{"type":"string","pattern":"^[1-9]\\\\d*$"}],"description":"First line, 1-based."},"limit":{"anyOf":[{"type":"number"},{"type":"string","pattern":"^[1-9]\\\\d*$"}],"description":"Number of lines."},"dense_line_numbers":{"type":"boolean"},"pages":{"type":"string","description":"PDF page range, for example 1-5; at most 20 pages."}},"required":["file_path"],"additionalProperties":false}}}],"thinking":{"type":"enabled"},"reasoning_effort":"low"}"`;

