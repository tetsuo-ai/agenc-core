{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "outDir": "./dist-test-support",
    "paths": {
      "bun:bundle": ["./src/build/feature.ts"],
      "bun:test": ["./tests/helpers/bun-test-shim.ts"],
      "src/*": ["./src/*"]
    },
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "tests/helpers/abort-harness.ts",
    "tests/helpers/bounded-file-io.ts",
    "tests/helpers/bounded-repository-filesystem.ts",
    "tests/helpers/bounded-repository-git-discovery.ts",
    "tests/helpers/bounded-repository-git-launch.ts",
    "tests/helpers/bounded-repository-git.ts",
    "tests/helpers/bounded-repository-lifecycle.ts",
    "tests/helpers/bounded-repository-metadata.ts",
    "tests/helpers/bounded-repository-ownership.ts",
    "tests/helpers/bounded-repository-policy.ts",
    "tests/helpers/bounded-repository-transaction-contract.ts",
    "tests/helpers/bounded-repository-transaction-filesystem.ts",
    "tests/helpers/bounded-repository-transaction-plan.ts",
    "tests/helpers/bounded-repository-transaction.ts",
    "tests/helpers/bounded-repository-types.ts",
    "tests/helpers/bounded-temp-repository.ts",
    "tests/helpers/bun-test-shim.ts",
    "tests/helpers/controlled-async.ts",
    "tests/helpers/deterministic-clock.ts",
    "tests/helpers/failure-plan.ts",
    "tests/helpers/fnd-fixture-inventory.ts",
    "tests/helpers/fnd-fixture-manifest.ts",
    "tests/helpers/fnd-fixture-materialization.ts",
    "tests/helpers/fnd-fixture-policy.ts",
    "tests/helpers/fnd-fixtures.ts",
    "tests/helpers/portable-repository-path.ts",
    "tests/helpers/seeded-rng.ts",
    "tests/helpers/unicode-15-1-repertoire.ts",
    "tests/fnd/bounded-file-io.test.ts",
    "tests/fnd/bounded-repository-git.test.ts",
    "tests/fnd/bounded-repository-transaction-races.test.ts",
    "tests/fnd/bounded-temp-repository.test.ts",
    "tests/fnd/deterministic-primitives.test.ts",
    "tests/fnd/fnd-fixtures.bun.test.ts",
    "tests/fnd/fnd-fixtures.test.ts",
    "tests/fnd/portable-repository-path.bun.test.ts",
    "tests/fnd/portable-repository-path.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
