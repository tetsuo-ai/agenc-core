{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "lib": ["ES2023"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "bun:bundle": ["./src/build/feature.ts"],
      "src/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    // Imports the live TUI renderer, which is excluded from the baseline
    // tsc gate until replacement is complete. This shipped prompt is still
    // covered by the required esbuild bundle because build.config.ts lists it
    // as a production entrypoint.
    "src/bin/tui-trust-prompt.tsx",
    "src/memdir/**/*",
    "src/commands/memory/memory.tsx",
    "src/tools/AgentTool/agentMemory.ts",
    "src/tools/AgentTool/agentMemorySnapshot.ts",
    "src/tools/ask-user-question/tui-tool.tsx",
    // Z-PURGEC verified temporary baseline boundary start.
    // Concrete migrated files still outside the baseline tsc gate.
    "src/commands/terminalSetup/terminalSetup.tsx",
    "src/services/voice.ts",
    "src/tui/components/App.tsx",
    "src/tui/components/AutoModeOptInDialog.tsx",
    "src/tui/components/AutoUpdaterWrapper.tsx",
    "src/tui/components/CoordinatorAgentStatus.tsx",
    "src/tui/components/ExitFlow.tsx",
    "src/tui/components/FullscreenLayout.tsx",
    "src/tui/components/GlobalSearchDialog.tsx",
    "src/tui/components/HelpV2/HelpV2.tsx",
    "src/tui/components/IdeStatusIndicator.tsx",
    "src/tui/components/MCPServerDesktopImportDialog.tsx",
    "src/tui/components/MessageRow.tsx",
    "src/tui/components/MessageSelector.tsx",
    "src/tui/components/Messages.tsx",
    "src/tui/components/OffscreenFreeze.tsx",
    "src/tui/components/PromptInput/HistorySearchInput.tsx",
    "src/tui/components/PromptInput/Notifications.tsx",
    "src/tui/components/PromptInput/PromptInput.tsx",
    "src/tui/components/PromptInput/PromptInputFooter.tsx",
    "src/tui/components/PromptInput/PromptInputFooterLeftSide.tsx",
    "src/tui/components/PromptInput/PromptInputHelpMenu.tsx",
    "src/tui/components/PromptInput/PromptInputModeIndicator.tsx",
    "src/tui/components/PromptInput/PromptInputStashNotice.tsx",
    "src/tui/components/PromptInput/SandboxPromptFooterHint.tsx",
    "src/tui/components/PromptInput/usePromptInputPlaceholder.ts",
    "src/tui/components/PromptInput/useSwarmBanner.ts",
    "src/tui/components/QuickOpenDialog.tsx",
    "src/tui/components/ScrollKeybindingHandler.tsx",
    "src/tui/components/SearchBox.tsx",
    "src/tui/components/TextInput.tsx",
    "src/tui/components/ThinkingToggle.tsx",
    "src/tui/components/VirtualMessageList.tsx",
    "src/tui/components/design-system/Dialog.tsx",
    "src/tui/components/design-system/Divider.tsx",
    "src/tui/components/design-system/FuzzyPicker.tsx",
    "src/tui/components/design-system/ListItem.tsx",
