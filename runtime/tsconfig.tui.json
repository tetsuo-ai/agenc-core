{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/tui",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "types": [],
    "paths": {
      "bun:bundle": ["./src/build/feature.ts"],
      "src/*": ["./src/*"]
    }
  },
  "include": ["src/tui/**/*", "src/**/*.d.ts"],
  // Override the base config's TUI exclusions so this project checks the TUI.
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
